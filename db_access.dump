INSERT INTO `application_type` VALUES (1,'Web Application','Aplikasi berbasis web (web-based application) adalah jenis aplikasi perangkat lunak yang diakses melalui browser web. Ini berarti pengguna dapat menggunakan aplikasi tersebut tanpa perlu mengunduh atau menginstalnya secara lokal di perangkat mereka. Aplikasi web ini menjalankan fungsinya di server web dan memberikan antarmuka pengguna melalui browser, memungkinkan akses dari berbagai perangkat dengan koneksi internet. ','2024-02-02 04:52:42','2024-02-02 04:52:42'),(2,'Mobile Application','Aplikasi berbasis mobile (mobile-based application) adalah jenis aplikasi perangkat lunak yang dirancang khusus untuk dijalankan pada perangkat mobile, seperti smartphone atau tablet. Aplikasi ini dapat diunduh dan diinstal langsung pada perangkat mobile pengguna melalui platform distribusi aplikasi, seperti Google Play Store untuk Android atau App Store untuk iOS.','2024-02-02 04:55:11','2024-02-02 04:55:11');
/*!40000 ALTER TABLE `application_type` ENABLE KEYS */;
UNLOCK TABLES;

